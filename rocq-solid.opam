# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Rocq development accompanying the rocq-solid talk"
license: "Apache-2.0"
homepage: "https://github.com/vbergeron/rocq-solid"
bug-reports: "https://github.com/vbergeron/rocq-solid/issues"
depends: [
  "dune" {>= "3.21" & >= "3.21"}
  "rocq-core" {>= "9.1" & < "9.2"}
  "rocq-stdlib" {>= "9.0" & < "9.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbergeron/rocq-solid.git"
x-maintenance-intent: ["(latest)"]
